rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCreator(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('name' in data) || (data.name is string && data.name.size() <= 500))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2000000));
    }

    // Health / connection test rule
    match /test/{testId} {
      allow read: if true;
    }

    // Creators directory: public browse list, single get, safe updates from admin or seed
    match /creators/{creatorId} {
      allow get: if isValidId(creatorId);
      allow list: if true;
      allow create, update: if isValidId(creatorId) && isValidCreator(incoming());
      allow delete: if isValidId(creatorId);
    }

    // Real photos & media assets
    match /photos/{photoId} {
      allow get: if isValidId(photoId);
      allow list: if true;
      allow create, update: if isValidId(photoId);
      allow delete: if isValidId(photoId);
    }

    // User accounts / subscriber profiles
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }
  }
}
